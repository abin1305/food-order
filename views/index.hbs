<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
function addToCart(productId) {
    $.ajax({
        url: '/add-to-cart/' + productId,
        method: 'get',
        success: (response) => {
            if (response.status) {
                // Assuming the response includes the new cart count, e.g., { status: true, cartCount: 3 }
                let cartCountSpan = $('.cart-count');
                if (cartCountSpan.length) {
                    cartCountSpan.text(response.cartCount);
                } else {
                    // If cart was empty, the count span might not exist. We create it.
                    $('a[href="/cart"]').append(`<span class="cart-count">${response.cartCount}</span>`);
                }
                // A simple notification. A more elegant "toast" notification would be even better!
                alert('Product added to cart!');
            } else {
                // If user is not logged in, redirect to login page.
                window.location.href = '/login';
            }
        },
        error: () => {
            alert('Sorry, something went wrong. Please try again.');
        }
    });
}
</script>
