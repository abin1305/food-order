<!-- MAIN PRODUCTS MENU SECTION -->
<section class="menu-section" id="menu">
  <div class="menu-container-header">
    <div>
      <span class="subheading-tag">POPULAR DISHES</span>
      <h2 class="section-title">Top Dishes Near You {{#if selectedCategory}}({{selectedCategory}}){{/if}}</h2>
    </div>

    <!-- Quick Search Input inside Menu -->
    <div class="menu-filter-search">
      <form action="/" method="GET" class="search-form">
        <input type="hidden" name="category" value="{{selectedCategory}}">
        <i class="fa-solid fa-magnifying-glass search-input-icon"></i>
        <input type="text" name="search" placeholder="Filter dishes..." value="{{searchQuery}}" class="menu-search-input">
        {{#if searchQuery}}
          <a href="/" class="clear-search-btn" title="Clear Search"><i class="fa-solid fa-xmark"></i></a>
        {{/if}}
      </form>
    </div>
  </div>

  <div class="products-grid">
    {{#if products.length}}
      {{#each products}}
      <div class="product-card">
        <div class="product-image-container">
          <img src="/product-images/{{this.image}}" alt="{{this.name}}" class="product-img" onerror="this.src='/product-images/pexels-ella-olsson-572949-1640777.jpg'">
          <div class="product-badges">
            {{#if this.isVeg}}
              <span class="diet-badge veg-badge" title="100% Vegetarian">
                <i class="fa-solid fa-leaf"></i> Veg
              </span>
            {{else}}
              <span class="diet-badge nonveg-badge" title="Non-Vegetarian">
                <i class="fa-solid fa-drumstick-bite"></i> Non-Veg
              </span>
            {{/if}}
            <span class="category-tag-badge">{{this.category}}</span>
          </div>
        </div>

        <div class="product-card-body">
          <div class="product-title-row">
            <h3 class="product-title">{{this.name}}</h3>
            <div class="product-rating">
              <i class="fa-solid fa-star text-warning"></i>
              <span>{{#if this.rating}}{{this.rating}}{{else}}4.7{{/if}}</span>
            </div>
          </div>

          <p class="product-description">{{this.description}}</p>

          <div class="product-meta-row">
            <div class="price-container">
              <span class="currency-symbol">Rs.</span>
              <span class="price-amount">{{this.price}}</span>
            </div>
            <div class="prep-time">
              <i class="fa-regular fa-clock"></i> {{#if this.prepTime}}{{this.prepTime}}{{else}}20-25 min{{/if}}
            </div>
          </div>

          <button class="btn-add-to-cart" onclick="addToCart('{{this._id}}', '{{this.name}}')">
            <i class="fa-solid fa-cart-plus"></i> Add to Cart
          </button>
        </div>
      </div>
      {{/each}}
    {{else}}
      <div class="no-products-found">
        <div class="empty-icon"><i class="fa-solid fa-bowl-rice"></i></div>
        <h3>No dishes found</h3>
        <p>We couldn't find any dishes matching your search query or selected category.</p>
        <a href="/" class="btn-primary-glow" style="margin-top: 15px; display: inline-block;">View All Menu Items</a>
      </div>
    {{/if}}
  </div>
</section>

