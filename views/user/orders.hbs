<div class="page-container orders-history-page">
  <div class="page-header">
    <h2><i class="fa-solid fa-receipt text-primary"></i> My Order History</h2>
    <p>Track your past and active food delivery orders.</p>
  </div>

  {{#if orders.length}}
    <div class="orders-list">
      {{#each orders}}
      <div class="order-card-item">
        <div class="order-card-header">
          <div>
            <span class="order-id">Order #{{this._id}}</span>
            <span class="order-date-time"><i class="fa-regular fa-clock"></i> {{this.date}} at {{this.time}}</span>
          </div>

          <div class="order-status-pill status-{{this.status}}">
            <i class="fa-solid fa-circle-dot"></i> {{this.status}}
          </div>
        </div>

        <div class="order-card-body">
          <div class="order-items-preview">
            {{#each this.products}}
            <div class="order-product-thumb">
              <img src="/product-images/{{this.product.image}}" alt="{{this.product.name}}" onerror="this.src='/product-images/pexels-ella-olsson-572949-1640777.jpg'">
              <div class="thumb-info">
                <strong>{{this.product.name}}</strong>
                <span>Qty: {{this.quantity}} &bull; Rs. {{multiply this.quantity this.product.price}}</span>
              </div>
            </div>
            {{/each}}
          </div>

          <div class="order-delivery-address">
            <strong><i class="fa-solid fa-location-dot"></i> Delivered To:</strong>
            <p>{{this.deliveryDetails.name}}, {{this.deliveryDetails.address}}, {{this.deliveryDetails.city}} (Ph: {{this.deliveryDetails.mobile}})</p>
          </div>
        </div>

        <div class="order-card-footer">
          <div class="payment-type">
            <span>Payment Mode: <strong>{{this.paymentMethod}}</strong></span>
          </div>
          
          <div class="order-amount-wrap">
            <span>Total Amount:</span>
            <strong class="total-val">Rs. {{this.totalAmount}}</strong>
          </div>

          <a href="/order-success/{{this._id}}" class="btn-outline-custom">
            <i class="fa-solid fa-eye"></i> View Receipt
          </a>
        </div>
      </div>
      {{/each}}
    </div>
  {{else}}
    <div class="empty-orders-view">
      <div class="empty-icon"><i class="fa-solid fa-box-open"></i></div>
      <h2>No Orders Found</h2>
      <p>You haven't placed any food orders yet. Craving something delicious?</p>
      <a href="/#menu" class="btn-primary-glow btn-lg" style="margin-top: 20px; display: inline-block;">
        <i class="fa-solid fa-utensils"></i> Order Food Now
      </a>
    </div>
  {{/if}}
</div>
