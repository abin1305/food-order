<div class="page-container cart-page">
  <div class="page-header">
    <h2><i class="fa-solid fa-basket-shopping text-primary"></i> Your Food Cart</h2>
    <p>Review items in your order, adjust quantities, and proceed to checkout.</p>
  </div>

  {{#if products.length}}
    <div class="cart-layout-grid">
      <!-- Cart Items List -->
      <div class="cart-items-wrapper">
        {{#each products}}
        <div class="cart-item-card" id="cart-item-{{this.product._id}}">
          <div class="cart-item-img-wrap">
            <img src="/product-images/{{this.product.image}}" alt="{{this.product.name}}" onerror="this.src='/product-images/pexels-ella-olsson-572949-1640777.jpg'">
          </div>

          <div class="cart-item-details">
            <div class="cart-item-header">
              <h3 class="cart-item-name">{{this.product.name}}</h3>
              <span class="cart-item-category">{{this.product.category}}</span>
            </div>
            <p class="cart-item-desc">{{this.product.description}}</p>
            
            <div class="cart-item-price-unit">
              Rs. {{this.product.price}} each
            </div>
          </div>

          <div class="cart-item-actions">
            <!-- Quantity Control -->
            <div class="quantity-control-box">
              <button class="qty-btn" onclick="changeQuantity('{{this._id}}', '{{this.product._id}}', -1, {{this.quantity}})" aria-label="Decrease Quantity">
                <i class="fa-solid fa-minus"></i>
              </button>
              <span class="qty-display" id="qty-{{this.product._id}}">{{this.quantity}}</span>
              <button class="qty-btn" onclick="changeQuantity('{{this._id}}', '{{this.product._id}}', 1, {{this.quantity}})" aria-label="Increase Quantity">
                <i class="fa-solid fa-plus"></i>
              </button>
            </div>

            <!-- Total Price for Item -->
            <div class="cart-item-total-price">
              Rs. <span class="item-subtotal" id="subtotal-{{this.product._id}}">{{multiply this.quantity this.product.price}}</span>
            </div>

            <!-- Remove Button -->
            <button class="cart-remove-btn" onclick="removeItem('{{this._id}}', '{{this.product._id}}', '{{this.product.name}}')" title="Remove item">
              <i class="fa-solid fa-trash-can"></i>
            </button>
          </div>
        </div>
        {{/each}}
      </div>

      <!-- Order Summary Card -->
      <div class="cart-summary-card">
        <h3 class="summary-title"><i class="fa-solid fa-receipt"></i> Order Summary</h3>
        
        <div class="summary-row">
          <span>Subtotal</span>
          <span class="summary-val">Rs. <span id="cartSubtotal">{{total}}</span></span>
        </div>
        <div class="summary-row">
          <span>Estimated Delivery Fee</span>
          <span class="summary-val text-success">FREE</span>
        </div>
        <div class="summary-row">
          <span>Taxes & Restaurant Charges</span>
          <span class="summary-val">Rs. 0</span>
        </div>

        <div class="summary-divider"></div>

        <div class="summary-row summary-total-row">
          <span>Total Amount</span>
          <span class="summary-total-price">Rs. <span id="cartGrandTotal">{{total}}</span></span>
        </div>

        <a href="/place-order" class="btn-primary-glow btn-block checkout-btn">
          Proceed to Checkout <i class="fa-solid fa-arrow-right"></i>
        </a>

        <a href="/#menu" class="continue-shopping-link">
          <i class="fa-solid fa-arrow-left"></i> Continue Shopping
        </a>
      </div>
    </div>
  {{else}}
    <div class="empty-cart-view">
      <div class="empty-cart-illustration">
        <i class="fa-solid fa-cart-flatbed-suitcases"></i>
      </div>
      <h2>Your Cart Is Empty</h2>
      <p>Looks like you haven't added any delicious food items to your cart yet.</p>
      <a href="/#menu" class="btn-primary-glow btn-lg" style="margin-top: 20px; display: inline-block;">
        <i class="fa-solid fa-utensils"></i> Browse Menu
      </a>
    </div>
  {{/if}}
</div>

<script>
function changeQuantity(cartId, productId, count, currentQty) {
  let qtyElement = $('#qty-' + productId);
  let currentVal = parseInt(qtyElement.text());
  
  if (currentVal === 1 && count === -1) {
    if (!confirm("Remove item from cart?")) return;
  }

  $.ajax({
    url: '/change-product-quantity',
    method: 'POST',
    data: {
      cart: cartId,
      product: productId,
      count: count,
      quantity: currentVal
    },
    success: (response) => {
      if (response.removeProduct) {
        showToast('Item removed from cart', 'info');
        $('#cart-item-' + productId).fadeOut(300, function() {
          $(this).remove();
          if ($('.cart-item-card').length === 0) {
            location.reload();
          }
        });
      } else {
        qtyElement.text(currentVal + count);
      }
      
      $('#cartSubtotal').text(response.total);
      $('#cartGrandTotal').text(response.total);
      $('#cartBadgeCount').text(response.cartCount);
    },
    error: () => {
      showToast('Error updating quantity', 'error');
    }
  });
}

function removeItem(cartId, productId, productName) {
  if (!confirm(`Remove "${productName}" from your cart?`)) return;

  $.ajax({
    url: '/remove-cart-product',
    method: 'POST',
    data: {
      cart: cartId,
      product: productId
    },
    success: (response) => {
      showToast(`Removed "${productName}" from cart`, 'info');
      $('#cart-item-' + productId).fadeOut(300, function() {
        $(this).remove();
        if ($('.cart-item-card').length === 0) {
          location.reload();
        }
      });
      $('#cartSubtotal').text(response.total);
      $('#cartGrandTotal').text(response.total);
      $('#cartBadgeCount').text(response.cartCount);
    }
  });
}
</script>
