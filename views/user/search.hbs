<div class="page-container">
  <div class="search-page-header">
    <span class="subheading-tag">SEARCH & FILTER</span>
    <h2>Find Your Favorite Dishes</h2>
    <p>Search by dish name, description, or filter by category.</p>

    <!-- Interactive Search Bar -->
    <div class="search-hero-box">
      <div class="search-hero-input-wrap">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" id="liveSearchInput" value="{{query}}" placeholder="Search pizzas, salads, burgers, desserts..." autocomplete="off">
        <button id="clearSearch" class="clear-btn" style="display: {{#if query}}block{{else}}none{{/if}};">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
    </div>

    <!-- Category Filter Pills -->
    <div class="category-pills-bar">
      <button class="pill-btn {{#if (eq category 'All')}}active{{/if}}" data-category="All">All Dishes</button>
      <button class="pill-btn {{#if (eq category 'Salad')}}active{{/if}}" data-category="Salad">Salads</button>
      <button class="pill-btn {{#if (eq category 'Rolls')}}active{{/if}}" data-category="Rolls">Rolls</button>
      <button class="pill-btn {{#if (eq category 'Desserts')}}active{{/if}}" data-category="Desserts">Desserts</button>
      <button class="pill-btn {{#if (eq category 'Sandwich')}}active{{/if}}" data-category="Sandwich">Sandwiches</button>
      <button class="pill-btn {{#if (eq category 'Cake')}}active{{/if}}" data-category="Cake">Cakes</button>
      <button class="pill-btn {{#if (eq category 'Pure Veg')}}active{{/if}}" data-category="Pure Veg">Pure Veg</button>
    </div>
  </div>

  <!-- Search Results Grid -->
  <div class="products-grid" id="searchResultsGrid">
    {{#if products.length}}
      {{#each products}}
      <div class="product-card">
        <div class="product-image-container">
          <img src="/product-images/{{this.image}}" alt="{{this.name}}" class="product-img" onerror="this.src='/product-images/pexels-ella-olsson-572949-1640777.jpg'">
          <div class="product-badges">
            {{#if this.isVeg}}
              <span class="diet-badge veg-badge"><i class="fa-solid fa-leaf"></i> Veg</span>
            {{else}}
              <span class="diet-badge nonveg-badge"><i class="fa-solid fa-drumstick-bite"></i> Non-Veg</span>
            {{/if}}
            <span class="category-tag-badge">{{this.category}}</span>
          </div>
        </div>

        <div class="product-card-body">
          <div class="product-title-row">
            <h3 class="product-title">{{this.name}}</h3>
            <div class="product-rating">
              <i class="fa-solid fa-star text-warning"></i>
              <span>{{#if this.rating}}{{this.rating}}{{else}}4.7{{/if}}</span>
            </div>
          </div>

          <p class="product-description">{{this.description}}</p>

          <div class="product-meta-row">
            <div class="price-container">
              <span class="currency-symbol">Rs.</span>
              <span class="price-amount">{{this.price}}</span>
            </div>
            <div class="prep-time">
              <i class="fa-regular fa-clock"></i> {{#if this.prepTime}}{{this.prepTime}}{{else}}20-25 min{{/if}}
            </div>
          </div>

          <button class="btn-add-to-cart" onclick="addToCart('{{this._id}}', '{{this.name}}')">
            <i class="fa-solid fa-cart-plus"></i> Add to Cart
          </button>
        </div>
      </div>
      {{/each}}
    {{else}}
      <div class="no-products-found">
        <div class="empty-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
        <h3>No matching dishes found</h3>
        <p>Try searching for something else or pick a different category.</p>
      </div>
    {{/if}}
  </div>
</div>

<script>
let currentCategory = '{{category}}' || 'All';
let searchDebounce = null;

$(document).ready(function() {
  $('#liveSearchInput').on('input', function() {
    let q = $(this).val();
    if (q.length > 0) {
      $('#clearSearch').show();
    } else {
      $('#clearSearch').hide();
    }
    clearTimeout(searchDebounce);
    searchDebounce = setTimeout(performLiveSearch, 250);
  });

  $('#clearSearch').on('click', function() {
    $('#liveSearchInput').val('');
    $(this).hide();
    performLiveSearch();
  });

  $('.pill-btn').on('click', function() {
    $('.pill-btn').removeClass('active');
    $(this).addClass('active');
    currentCategory = $(this).data('category');
    performLiveSearch();
  });
});

function performLiveSearch() {
  let query = $('#liveSearchInput').val();
  $.ajax({
    url: '/api/search',
    method: 'GET',
    data: { q: query, category: currentCategory },
    success: (res) => {
      renderSearchGrid(res.products);
    }
  });
}

function renderSearchGrid(products) {
  let grid = $('#searchResultsGrid');
  grid.empty();
  if (!products || products.length === 0) {
    grid.html(`
      <div class="no-products-found">
        <div class="empty-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
        <h3>No matching dishes found</h3>
        <p>Try searching for something else or pick a different category.</p>
      </div>
    `);
    return;
  }

  products.forEach(p => {
    let vegBadge = p.isVeg 
      ? `<span class="diet-badge veg-badge"><i class="fa-solid fa-leaf"></i> Veg</span>` 
      : `<span class="diet-badge nonveg-badge"><i class="fa-solid fa-drumstick-bite"></i> Non-Veg</span>`;
    
    let html = `
      <div class="product-card">
        <div class="product-image-container">
          <img src="/product-images/${p.image}" alt="${p.name}" class="product-img" onerror="this.src='/product-images/pexels-ella-olsson-572949-1640777.jpg'">
          <div class="product-badges">
            ${vegBadge}
            <span class="category-tag-badge">${p.category}</span>
          </div>
        </div>

        <div class="product-card-body">
          <div class="product-title-row">
            <h3 class="product-title">${p.name}</h3>
            <div class="product-rating">
              <i class="fa-solid fa-star text-warning"></i>
              <span>${p.rating || 4.7}</span>
            </div>
          </div>

          <p class="product-description">${p.description}</p>

          <div class="product-meta-row">
            <div class="price-container">
              <span class="currency-symbol">Rs.</span>
              <span class="price-amount">${p.price}</span>
            </div>
            <div class="prep-time">
              <i class="fa-regular fa-clock"></i> ${p.prepTime || '20-25 min'}
            </div>
          </div>

          <button class="btn-add-to-cart" onclick="addToCart('${p._id}', '${p.name}')">
            <i class="fa-solid fa-cart-plus"></i> Add to Cart
          </button>
        </div>
      </div>
    `;
    grid.append(html);
  });
}

function addToCart(productId, productName) {
  $.ajax({
    url: '/add-to-cart/' + productId,
    method: 'GET',
    success: (response) => {
      if (response.status) {
        $('#cartBadgeCount').text(response.cartCount).addClass('bounce');
        setTimeout(() => $('#cartBadgeCount').removeClass('bounce'), 600);
        showToast(`" ${productName} " added to your cart!`, 'success');
      } else {
        showToast('Please sign in to add items to your cart', 'error');
        setTimeout(() => {
          window.location.href = '/login';
        }, 1200);
      }
    }
  });
}
</script>
