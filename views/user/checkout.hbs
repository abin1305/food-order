<div class="page-container checkout-page">
  <div class="page-header text-center">
    <span class="subheading-tag">FINAL STEP</span>
    <h2>Delivery Details & Checkout</h2>
    <p>Please enter your address and choose your preferred payment option.</p>
  </div>

  <div class="checkout-layout-grid">
    <!-- Delivery Address & Payment Form -->
    <form id="checkoutForm" class="checkout-form-card">
      <h3 class="form-section-title"><i class="fa-solid fa-truck"></i> Delivery Information</h3>

      <div class="form-group-row">
        <div class="form-group">
          <label for="name"><i class="fa-solid fa-user"></i> Full Name</label>
          <input type="text" id="name" name="name" value="{{user.name}}" placeholder="Enter your full name" required>
        </div>

        <div class="form-group">
          <label for="mobile"><i class="fa-solid fa-phone"></i> Mobile Phone</label>
          <input type="tel" id="mobile" name="mobile" placeholder="10-digit mobile number" required pattern="[0-9]{10}">
        </div>
      </div>

      <div class="form-group">
        <label for="address"><i class="fa-solid fa-house"></i> Full Address</label>
        <textarea id="address" name="address" rows="3" placeholder="House no, Street name, Area, Landmark" required></textarea>
      </div>

      <div class="form-group-row">
        <div class="form-group">
          <label for="pincode"><i class="fa-solid fa-location-dot"></i> Pincode</label>
          <input type="text" id="pincode" name="pincode" placeholder="e.g. 682001" required>
        </div>

        <div class="form-group">
          <label for="city"><i class="fa-solid fa-city"></i> City / Town</label>
          <input type="text" id="city" name="city" placeholder="City name" required>
        </div>
      </div>

      <h3 class="form-section-title" style="margin-top: 30px;"><i class="fa-solid fa-credit-card"></i> Payment Method</h3>

      <div class="payment-options">
        <label class="payment-card-option">
          <input type="radio" name="paymentMethod" value="COD" checked>
          <div class="payment-card-content">
            <i class="fa-solid fa-money-bill-wave option-icon text-success"></i>
            <div>
              <strong>Cash on Delivery (COD)</strong>
              <span>Pay with cash when food is delivered to your door</span>
            </div>
          </div>
        </label>

        <label class="payment-card-option">
          <input type="radio" name="paymentMethod" value="ONLINE">
          <div class="payment-card-content">
            <i class="fa-solid fa-qrcode option-icon text-primary"></i>
            <div>
              <strong>Online Payment (UPI / Credit / Debit)</strong>
              <span>Fast & secure digital payment via Razorpay / GPay</span>
            </div>
          </div>
        </label>
      </div>

      <button type="submit" class="btn-primary-glow btn-block btn-lg" style="margin-top: 25px;">
        <i class="fa-solid fa-check-circle"></i> Confirm & Place Order
      </button>
    </form>

    <!-- Right Side Order Invoice Preview -->
    <div class="checkout-summary-card">
      <h3 class="summary-title"><i class="fa-solid fa-receipt"></i> Order Total</h3>

      <div class="summary-row">
        <span>Items Subtotal</span>
        <span class="summary-val">Rs. {{total}}</span>
      </div>
      <div class="summary-row">
        <span>Delivery Charge</span>
        <span class="summary-val text-success">FREE</span>
      </div>
      <div class="summary-row">
        <span>GST & Restaurant Tax</span>
        <span class="summary-val">Rs. 0</span>
      </div>

      <div class="summary-divider"></div>

      <div class="summary-row summary-total-row">
        <span>Grand Total</span>
        <span class="summary-total-price">Rs. {{total}}</span>
      </div>

      <div class="guarantee-box">
        <i class="fa-solid fa-shield-halved text-success"></i>
        <span>100% Safe & Secure Checkout Guarantee</span>
      </div>
    </div>
  </div>
</div>

<script>
$('#checkoutForm').submit(function(e) {
  e.preventDefault();
  
  $.ajax({
    url: '/place-order',
    method: 'POST',
    data: $(this).serialize(),
    success: (response) => {
      if (response.status) {
        showToast('Order placed successfully! Redirecting...', 'success');
        setTimeout(() => {
          window.location.href = '/order-success/' + response.orderId;
        }, 1000);
      } else {
        showToast('Failed to place order. Please try again.', 'error');
      }
    },
    error: () => {
      showToast('Error connecting to server.', 'error');
    }
  });
});
</script>
