<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Product</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
        }
        .container {
            max-width: 600px;
            margin: 50px auto;
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
        h1 {
            text-align: center;
            color: #333;
        }
        form {
            display: flex;
            flex-direction: column;
        }
        label {
            margin-top: 10px;
            font-weight: bold;
        }
        input, textarea, select {
            padding: 10px;
            margin-top: 5px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 16px;
        }
        button {
            margin-top: 20px;
            padding: 10px;
            background-color: #28a745;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 16px;
        }
        button:hover {
            background-color: #218838;
        }
        .current-image {
            max-width: 200px;
            margin-top: 10px;
            border-radius: 4px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Edit Product</h1>
        <form action="/admin/edit-product/{{product._id}}" method="post" enctype="multipart/form-data">
            <label for="name">Product Name:</label>
            <input type="text" id="name" name="name" value="{{product.name}}" required>

            <label for="category">Category:</label>
            <select id="category" name="category" required>
                <option value="Salad" {{#eq product.category "Salad"}}selected{{/eq}}>Salad</option>
                <option value="Rolls" {{#eq product.category "Rolls"}}selected{{/eq}}>Rolls</option>
                <option value="Desserts" {{#eq product.category "Desserts"}}selected{{/eq}}>Desserts</option>
                <option value="Sandwich" {{#eq product.category "Sandwich"}}selected{{/eq}}>Sandwich</option>
            </select>

            <label for="price">Price:</label>
            <input type="number" id="price" name="price" value="{{product.price}}" step="0.01" required>

            <label for="description">Description:</label>
            <textarea id="description" name="description" rows="4" required>{{product.description}}</textarea>

            <label>Current Image:</label>
            <img src="/product-images/{{product.image}}" alt="{{product.name}}" class="current-image">

            <label for="image">New Image (optional):</label>
            <input type="file" id="image" name="image" accept="image/*">

            <button type="submit">Update Product</button>
        </form>
    </div>
</body>
</html>