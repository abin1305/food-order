<div class="page-container admin-form-page">
  <div class="admin-page-header">
    <div>
      <h2><i class="fa-solid fa-pen text-primary"></i> Edit Dish Details</h2>
      <p>Modify information for dish: <strong>{{product.name}}</strong></p>
    </div>

    <a href="/admin/products" class="btn-outline-custom">
      <i class="fa-solid fa-arrow-left"></i> Back to Products
    </a>
  </div>

  <div class="admin-panel-card max-width-700 margin-auto">
    <form action="/admin/edit-product/{{product._id}}" method="POST" enctype="multipart/form-data" class="admin-crud-form">
      <div class="form-group-row">
        <div class="form-group">
          <label for="name">Dish Name</label>
          <input type="text" id="name" name="name" value="{{product.name}}" required>
        </div>

        <div class="form-group">
          <label for="category">Category</label>
          <input type="text" id="category" name="category" value="{{product.category}}" required>
        </div>
      </div>

      <div class="form-group-row">
        <div class="form-group">
          <label for="price">Price (Rs.)</label>
          <input type="number" id="price" name="price" value="{{product.price}}" required>
        </div>

        <div class="form-group">
          <label for="prepTime">Preparation Time</label>
          <input type="text" id="prepTime" name="prepTime" value="{{#if product.prepTime}}{{product.prepTime}}{{else}}20-25 min{{/if}}">
        </div>
      </div>

      <div class="form-group-row">
        <div class="form-group">
          <label for="rating">Star Rating (1.0 to 5.0)</label>
          <input type="number" id="rating" name="rating" step="0.1" min="1.0" max="5.0" value="{{#if product.rating}}{{product.rating}}{{else}}4.8{{/if}}">
        </div>

        <div class="form-group">
          <label for="isVeg">Dietary Type</label>
          <select id="isVeg" name="isVeg">
            <option value="true" {{#if product.isVeg}}selected{{/if}}>Vegetarian (Veg)</option>
            <option value="false" {{#unless product.isVeg}}selected{{/unless}}>Non-Vegetarian (Non-Veg)</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label for="description">Short Description</label>
        <textarea id="description" name="description" rows="3" required>{{product.description}}</textarea>
      </div>

      <div class="form-group">
        <label for="image">Change Dish Image (Optional)</label>
        <div style="display: flex; gap: 15px; align-items: center; margin-bottom: 10px;">
          <img id="imgPreview" src="/product-images/{{product.image}}" alt="{{product.name}}" style="max-height: 100px; border-radius: 8px; border: 1px solid #ddd;" onerror="this.src='/product-images/pexels-ella-olsson-572949-1640777.jpg'">
          <span class="text-muted">Current photo</span>
        </div>
        <input type="file" id="image" name="image" accept="image/*" class="file-input-field" onchange="previewImage(event)">
      </div>

      <button type="submit" class="btn-primary-glow btn-block btn-lg" style="margin-top: 25px;">
        <i class="fa-solid fa-save"></i> Save Changes
      </button>
    </form>
  </div>
</div>

<script>
function previewImage(event) {
  let reader = new FileReader();
  reader.onload = function() {
    let output = document.getElementById('imgPreview');
    output.src = reader.result;
  };
  if(event.target.files[0]) {
    reader.readAsDataURL(event.target.files[0]);
  }
}
</script>