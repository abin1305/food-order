<div class="page-container admin-products-page">
  <div class="admin-page-header">
    <div>
      <h2><i class="fa-solid fa-boxes-stacked text-primary"></i> Manage Products</h2>
      <p>View, edit, update, or remove dishes from your store catalog.</p>
    </div>

    <a href="/admin/add-product" class="btn-primary-glow">
      <i class="fa-solid fa-plus-circle"></i> Add New Product
    </a>
  </div>

  <div class="admin-panel-card">
    <div class="table-toolbar">
      <div class="search-box-wrapper width-300">
        <i class="fa-solid fa-magnifying-glass search-input-icon"></i>
        <input type="text" id="adminProductFilter" placeholder="Filter dishes by name or category..." class="header-search-input">
      </div>
      <span class="text-muted">Showing {{products.length}} item(s)</span>
    </div>

    <div class="table-responsive">
      <table class="admin-data-table" id="productsTable">
        <thead>
          <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Type</th>
            <th>Rating</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#each products}}
          <tr>
            <td>
              <img src="/product-images/{{this.image}}" alt="{{this.name}}" class="table-thumb-img" onerror="this.src='/product-images/pexels-ella-olsson-572949-1640777.jpg'">
            </td>
            <td>
              <strong>{{this.name}}</strong>
              <div class="table-subtext">{{this.description}}</div>
            </td>
            <td><span class="category-tag-badge">{{this.category}}</span></td>
            <td><strong>Rs. {{this.price}}</strong></td>
            <td>
              {{#if this.isVeg}}
                <span class="diet-badge veg-badge"><i class="fa-solid fa-leaf"></i> Veg</span>
              {{else}}
                <span class="diet-badge nonveg-badge"><i class="fa-solid fa-drumstick-bite"></i> Non-Veg</span>
              {{/if}}
            </td>
            <td>
              <span class="text-warning"><i class="fa-solid fa-star"></i> {{#if this.rating}}{{this.rating}}{{else}}4.7{{/if}}</span>
            </td>
            <td class="text-right">
              <a href="/admin/edit-product/{{this._id}}" class="btn-sm-action btn-edit" title="Edit Product">
                <i class="fa-solid fa-pen"></i> Edit
              </a>
              <a href="/admin/delete-product/{{this._id}}" class="btn-sm-action btn-delete" onclick="return confirm('Are you sure you want to delete {{this.name}}?')" title="Delete Product">
                <i class="fa-solid fa-trash"></i> Delete
              </a>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
$('#adminProductFilter').on('keyup', function() {
  let val = $(this).val().toLowerCase();
  $('#productsTable tbody tr').filter(function() {
    $(this).toggle($(this).text().toLowerCase().indexOf(val) > -1);
  });
});
</script>